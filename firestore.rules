rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(resourceData) {
      return isAuthenticated() && request.auth.uid == resourceData.reporterId;
    }

    match /reports/{reportId} {
      // Anyone can read reports (public feed/map)
      allow read: if true;
      
      // Only authenticated users can create new reports
      // And they must set reporterId to their own uid
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      
      // Only the creator can update or delete their own reports
      allow update, delete: if isOwner(resource.data);
    }
  }
}
