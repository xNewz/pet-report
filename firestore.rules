rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'user';
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isOfficial() {
      return isAuthenticated() && getUserRole() == 'official';
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(resourceData) {
      return isAuthenticated() && ('reporterId' in resourceData) && request.auth.uid == resourceData.reporterId;
    }

    match /reports/{reportId} {
      // Anyone can read reports (public feed/map)
      allow read: if true;
      
      // Only authenticated users can create new reports
      // And they must set reporterId to their own uid
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      
      // The creator, admins, and officials can update reports
      allow update: if isAdmin() || isOfficial() || isOwner(resource.data);
      
      // Only the creator and admin can delete reports
      allow delete: if isAdmin() || isOwner(resource.data);
    }

    match /users/{userId} {
      // Users can read their own profile, admins can read all profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Admins can create any user profile
      // Users can create their own profile, but must default role to "user"
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.get('role', 'user') == 'user')
      );
      
      // Admins can update any user profile
      // Users can update their own profile, but cannot change their role
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.get('role', 'user') == resource.data.get('role', 'user'))
      );
    }
  }
}
